---
import Layout from '../components/Layout.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import PenyadapIntro from '../components/PenyadapIntro.astro';
import ThreeStepProcess from '../components/ThreeStepProcess.astro';
import Testimonials from '../components/Testimonials.astro';
import SupportHighlights from '../components/SupportHighlights.astro';
import FAQ from '../components/FAQ.astro';

const mdPostsGlob = import.meta.glob('../content/blog/*.md', { eager: true });
const mdxPostsGlob = import.meta.glob('../content/blog/*.mdx', { eager: true });

const allPosts = [...Object.values(mdPostsGlob), ...Object.values(mdxPostsGlob)] as any[];
// Data disiapkan di sini supaya markup kartu tetap bersih
const sortedPosts = allPosts
  .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3)
  .map((post: any) => ({
    title: post.frontmatter.title,
    url: `${import.meta.env.BASE_URL}blog/${post.file.split('/').pop()?.replace(/\.(md|mdx)$/, '')}/`,
    date: post.frontmatter.date,
    excerpt: post.frontmatter.excerpt || post.frontmatter.description,
    category: post.frontmatter.categories?.[0],
    thumbnail: post.frontmatter.thumbnail
      ? `${import.meta.env.BASE_URL}${String(post.frontmatter.thumbnail).replace(/^\/+/, '')}`
      : undefined,
  }));
---

<Layout title="Jasa Install Aplikasi XNspy Pengawas HP Anak Dari Jarak Jauh" description="Layanan profesional instalasi aplikasi XNspy untuk pengawasan HP anak dari jarak jauh dengan aman dan legal." showSidebar={false} isHomepage={true}>
  <div class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-card">
        <p class="hero-badge">Sadap · Android &amp; iOS</p>
        <h1 class="hero-title">Jasa Install Aplikasi Sadap XNspy Jarak Jauh (iPhone dan Android)</h1>
        <p class="hero-subtitle">Pengawas HP Anak Dari Jarak Jauh</p>
        <p class="hero-description">
          Layanan profesional instalasi aplikasi XNspy untuk pengawasan perangkat anak 
          secara aman, legal, dan terpercaya dari jarak jauh.
        </p>
        <hr class="hero-rule" />
        <div class="hero-actions">
          <a href="https://wa.me/6285111426625" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Hubungi Kami</a>
          <a href="https://demo.penyadap.com" class="btn btn-secondary" target="_blank" rel="nofollow noreferrer">Lihat Demo</a>
        </div>
        <ul class="hero-points">
          <li>Pemasangan langsung ke perangkat</li>
          <li>Panduan lengkap via email</li>
          <li>Dukungan teknis 24/7</li>
        </ul>
      </div>
    </section>

    <!-- Artikel Section -->
    <section class="demo-section" id="artikel">
      <div class="container">
        <h2 class="section-title">Panduan &amp; Artikel</h2>
        <p class="demo-description">
          Artikel terbaru seputar cara kerja aplikasi pemantauan, tips pengawasan anak,
          dan hal yang perlu Anda ketahui sebelum memesan layanan.
        </p>
        
        {sortedPosts.length > 0 && (
          <div class="demo-posts">
            {sortedPosts.map(post => (
              <article class="demo-post-card">
                {post.thumbnail && (
                  <div class="demo-post-media">
                    <img src={post.thumbnail} alt="" loading="lazy" decoding="async" />
                  </div>
                )}

                <div class="demo-post-body">
                  <div class="demo-post-meta">
                    <time class="demo-post-date" datetime={post.date}>
                      {new Date(post.date).toLocaleDateString('id-ID', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>

                    {post.category && <span class="demo-category">{post.category}</span>}
                  </div>

                  <h3 class="demo-post-title">
                    <a href={post.url}>{post.title}</a>
                  </h3>

                  {post.excerpt && <p class="demo-post-excerpt">{post.excerpt}</p>}

                  <span class="demo-post-more">Baca selengkapnya</span>
                </div>
              </article>
            ))}
          </div>
        )}
        
        <div class="demo-actions">
          <a href={`${import.meta.env.BASE_URL}blog/`} class="btn btn-primary">Lihat Blog</a>
        </div>
      </div>
    </section>

    <!-- Features Grid Component -->
    <FeaturesGrid />

    <!-- Three Step Process Component -->
    <ThreeStepProcess />

    <!-- Testimonials Component -->
    <Testimonials />

    <!-- Support Highlights Component -->
    <SupportHighlights />

    <!-- Penyadap Intro Section -->
    <PenyadapIntro />

    <!-- FAQ Component -->
    <FAQ />
  </div>
</Layout>

<style>
  .landing-page {
    width: 100%;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  /*/ Hero: dot-grid gelap + glow merah halus, konten di dalam kartu.
     Background break-out ke full viewport width supaya tidak terpotong. */
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: calc(var(--grid-unit) * 10) var(--content-padding) calc(var(--grid-unit) * 8);
    background-color: var(--color-background);
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 22px 22px;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -30%;
    left: 50%;
    width: min(1100px, 120%);
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(227, 2, 32, 0.16) 0%, rgba(227, 2, 32, 0) 62%);
    pointer-events: none;
  }

  .hero-card {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: calc(var(--grid-unit) * 8) calc(var(--grid-unit) * 6);
    text-align: center;
    background: linear-gradient(160deg, var(--color-white) 0%, var(--color-surface) 100%);
    border: 1px solid var(--color-border);
    border-top: 6px solid var(--color-accent);
    border-radius: 20px;
    box-shadow: 0 20px 45px rgba(36, 32, 36, 0.08);
  }

  :global([data-theme="dark"]) .hero-card {
    background: linear-gradient(160deg, var(--color-surface) 0%, var(--color-background) 100%);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: calc(var(--grid-unit) * 0.75) calc(var(--grid-unit) * 2);
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .hero-title {
    font-family: var(--font-heading-primary);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.05;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .hero-subtitle {
    font-family: var(--font-heading-secondary);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: calc(var(--grid-unit) * 4);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-rule {
    height: 6px;
    background-color: var(--color-accent);
    border: none;
    width: 150px;
    margin: 0 auto calc(var(--grid-unit) * 4);
  }

  .hero-actions {
    display: flex;
    gap: calc(var(--grid-unit) * 2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--grid-unit) * 2) calc(var(--grid-unit) * 3);
    margin-top: calc(var(--grid-unit) * 5);
    padding-top: calc(var(--grid-unit) * 4);
    border-top: 1px solid var(--color-border);
  }

  .hero-points li {
    display: flex;
    align-items: center;
    gap: calc(var(--grid-unit));
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .hero-points li::before {
    content: '✓';
    color: var(--color-accent);
    font-weight: 700;
  }

  .btn {
    font-family: var(--font-heading-secondary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
    border-radius: 4px;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    font-size: 0.95rem;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: white;
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover,
  .btn-primary:focus {
    background-color: transparent;
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-text-primary);
  }

  .btn-secondary:hover,
  .btn-secondary:focus {
    background-color: var(--color-text-primary);
    color: var(--color-background);
    transform: translateY(-2px);
  }

  /*/ Dark mode button styles */
  :global([data-theme="dark"]) .btn-primary {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  :global([data-theme="dark"]) .btn-primary:hover,
  :global([data-theme="dark"]) .btn-primary:focus {
    background-color: transparent;
    color: var(--color-accent);
  }

  :global([data-theme="dark"]) .btn-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  :global([data-theme="dark"]) .btn-secondary:hover,
  :global([data-theme="dark"]) .btn-secondary:focus {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .section-title {
    font-family: var(--font-heading-secondary);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: calc(var(--grid-unit) * 6);
    text-align: center;
  }

  .demo-section {
    padding: calc(var(--grid-unit) * 8) 0;
    background: var(--color-light-gray);
  }

  :global([data-theme="dark"]) .demo-section {
    background: var(--color-background);
  }

  .demo-description {
    text-align: center;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .demo-posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--grid-unit) * 4);
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  @media (min-width: 900px) {
    .demo-posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Kartu artikel: gambar di atas + isi editorial.
     Seluruh kartu bisa diklik lewat stretched link pada judul. */
  .demo-post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-white) 0%, var(--color-surface) 100%);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .demo-post-card:hover,
  .demo-post-card:focus-within {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 18px 38px rgba(227, 2, 32, 0.14);
  }

  :global([data-theme="dark"]) .demo-post-card {
    background: linear-gradient(160deg, var(--color-surface) 0%, var(--color-background) 100%);
  }

  :global([data-theme="dark"]) .demo-post-card:hover,
  :global([data-theme="dark"]) .demo-post-card:focus-within {
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.55);
  }

  .demo-post-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface);
    border-bottom: 3px solid var(--color-accent);
    border-radius: 18px 18px 0 0;
  }

  .demo-post-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    transition: transform 0.4s ease;
  }

  .demo-post-card:hover .demo-post-media img,
  .demo-post-card:focus-within .demo-post-media img {
    transform: scale(1.05);
  }

  .demo-post-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: calc(var(--grid-unit) * 3);
  }

  .demo-post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--grid-unit));
    margin-bottom: calc(var(--grid-unit) * 1.5);
  }

  .demo-post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .demo-post-title {
    font-family: var(--font-heading-secondary);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: calc(var(--grid-unit) * 1.5);
  }

  .demo-post-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .demo-post-title a:hover,
  .demo-post-title a:focus {
    color: var(--color-accent);
  }

  /* Stretched link: memperluas area klik judul ke seluruh kartu */
  .demo-post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .demo-post-excerpt {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: calc(var(--grid-unit) * 2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .demo-post-more {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .demo-post-more::after {
    content: '→';
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.25s ease;
  }

  .demo-post-card:hover .demo-post-more::after,
  .demo-post-card:focus-within .demo-post-more::after {
    transform: translateX(4px);
  }

  .demo-category {
    background-color: var(--color-accent);
    color: #ffffff;
    padding: calc(var(--grid-unit) / 4) calc(var(--grid-unit));
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    white-space: nowrap;
  }

  /*/ Dark mode demo category styles */
  :global([data-theme="dark"]) .demo-category {
    color: #241f24;
  }

  .demo-actions {
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero {
      padding: calc(var(--grid-unit) * 6) var(--content-padding) calc(var(--grid-unit) * 5);
      background-size: 18px 18px;
    }

    .hero-card {
      padding: calc(var(--grid-unit) * 5) calc(var(--grid-unit) * 3);
      border-radius: 16px;
    }

    .hero-subtitle {
      font-size: 1rem;
      letter-spacing: 0.15em;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .hero-points {
      flex-direction: column;
      align-items: center;
      gap: calc(var(--grid-unit) * 1.5);
    }
  }
</style>