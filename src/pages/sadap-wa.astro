            <div class="demo-card">
              <h3 class="feature-title">{demo.title}</h3>
              <img src={demo.image} alt={`Demo ${demo.title}`} loading="lazy" />
              <p class="feature-desc">{demo.dest}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- fitur_222: 3 fitur lanjutan -->
    <section class="section">
      <div class="container container--wide">
        <h2 class="section-title">Fitur Sadap Lainnya: Pesan, Browser &amp; Kamera</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="6em" height="6em" viewBox="0 0 16 16" class="bi bi-envelope-open" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M8.47 1.318a1 1 0 0 0-.94 0l-6 3.2A1 1 0 0 0 1 5.4v.818l5.724 3.465L8 8.917l1.276.766L15 6.218V5.4a1 1 0 0 0-.53-.882l-6-3.2zM15 7.388l-4.754 2.877L15 13.117v-5.73zm-.035 6.874L8 10.083l-6.965 4.18A1 1 0 0 0 2 15h12a1 1 0 0 0 .965-.738zM1 13.117l4.754-2.852L1 7.387v5.73zM7.059.435a2 2 0 0 1 1.882 0l6 3.2A2 2 0 0 1 16 5.4V14a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V5.4a2 2 0 0 1 1.059-1.765l6-3.2z" /></svg>
            </div>
            <h3 class="feature-title">SADAP PESAN</h3>
            <p class="feature-desc">
              Sadap data pesan teks SMS dan Gmail yang dikirim dan diterima. bisa juga
              mendapatkan detail pengirim, penerimaan, dan tanggal / waktu beserta pesan teks LENGKAP.
            </p>
          </div>

