---
import Layout from '../components/Layout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { extractHeadings, filterHeadingsForTOC } from '../utils/table-of-contents';

// Halaman statis (About, Jasa Sadap, Ketentuan Layanan, Privacy Policy, dll).
// Sumber konten: src/content/pages, nama file dipakai sebagai slug URL.
export async function getStaticPaths() {
  const pagesGlob = import.meta.glob('../content/pages/*.{md,mdx}', { eager: true });

  // File yang sudah punya halaman khusus tidak dibuatkan route lagi,
  // misal about-me.md dirender oleh src/pages/about.astro
  const handledByDedicatedPage = ['about-me'];

  return Object.entries(pagesGlob)
    .filter(([, mod]: [string, any]) => mod?.frontmatter?.draft !== true)
    .filter(([path]) => {
      const slug = path.split('/').pop()?.replace(/\.(md|mdx)$/, '') || '';
      return !handledByDedicatedPage.includes(slug);
    })
    .map(([path, mod]: [string, any]) => ({
      params: { page: path.split('/').pop()?.replace(/\.(md|mdx)$/, '') },
      props: { mod },
    }));
}

const { mod } = Astro.props as any;
const { frontmatter, Content } = mod;

// Heading diambil dari markdown mentah untuk membangun daftar isi
const rawContent = mod.body || mod.rawContent?.() || '';
const tocHeadings = filterHeadingsForTOC(extractHeadings(rawContent));
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  type="page"
>
  <article class="static-page">
    <header class="page-header">
      <h1 class="page-title">{frontmatter.title}</h1>
      <hr class="page-rule" />
      {frontmatter.description && <p class="page-description">{frontmatter.description}</p>}
    </header>

    {frontmatter.toc !== false && <TableOfContents headings={tocHeadings} />}

    <div class="page-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .static-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .page-title {
    font-family: var(--font-heading-primary);
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.1;
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .page-rule {
    height: 6px;
    background-color: var(--color-accent);
    border: none;
    margin: calc(var(--grid-unit) * 3) 0;
    width: 100%;
  }

  .page-description {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    font-style: italic;
    margin: 0;
  }

  .page-content {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .page-content :global(h2) {
    font-family: var(--font-heading-secondary);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: calc(var(--grid-unit) * 6);
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .page-content :global(h3) {
    font-family: var(--font-heading-secondary);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: calc(var(--grid-unit) * 4);
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .page-content :global(p) {
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .page-content :global(a) {
    color: var(--color-accent);
  }

  /* Link di dalam blockquote berdiri di atas latar abu (--color-surface) bersama
     teks abu-abu, jadi hanya bisa dibedakan dari warnanya (WCAG 1.4.1) padahal
     aksen penuh cuma ~4.4:1. Pakai aksen versi teks (>= 4.5:1) + garis bawah. */
  .page-content :global(blockquote a) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page-content :global(ul),
  .page-content :global(ol) {
    margin-bottom: calc(var(--grid-unit) * 3);
    padding-left: calc(var(--grid-unit) * 3);
  }

  .page-content :global(li) {
    margin-bottom: calc(var(--grid-unit) / 2);
  }

  .page-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: calc(var(--grid-unit) * 2) calc(var(--grid-unit) * 3);
    margin: calc(var(--grid-unit) * 4) 0;
    background-color: var(--color-surface);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .page-content :global(img) {
    border: 2px solid var(--color-border);
    border-radius: 16px;
    margin: calc(var(--grid-unit) * 4) 0;
    max-width: 100%;
    height: auto;
  }

  .page-content :global(hr) {
    height: 2px;
    background-color: var(--color-accent);
    border: none;
    margin: calc(var(--grid-unit) * 4) 0;
  }

  .page-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: calc(var(--grid-unit) * 4) 0;
  }

  .page-content :global(th),
  .page-content :global(td) {
    border: 1px solid var(--color-border);
    padding: calc(var(--grid-unit));
    text-align: left;
  }

  /* CTA WhatsApp yang dipakai di dalam konten markdown */
  .page-content :global(.wa-cta) {
    display: inline-block;
    background-color: var(--color-wa);
    color: #ffffff;
    font-family: var(--font-heading-secondary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
    border-radius: 4px;
    margin: calc(var(--grid-unit) * 2) 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .page-content :global(.wa-cta:hover),
  .page-content :global(.wa-cta:focus) {
    background-color: var(--color-wa-hover);
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
    }

    .page-content {
      font-size: 1rem;
    }
  }
</style>
