---
interface Props {
  title?: string;
  subtitle?: string;
  phone?: string;
  imageUrl?: string;
  features?: string[];
}

const {
  title = "Aplikasi Pengawas HP Jarak Jauh?",
  subtitle = "Mendukung iPhone & Android",
  phone = "6285111426625",
  imageUrl = "/images/sadap-phone.webp",
  features = [
    "💬 Monitoring aktivitas aplikasi pesan (WhatsApp, Telegram, Line, Instagram, Facebook, Skype, Viber, Snapchat)",
    "📷 Pemantauan kamera & layar dengan izin pemilik perangkat",
    "📞 Riwayat panggilan telepon & akses galeri"
  ]
} = Astro.props;
---

<div class="qc-wrapper">
  <div class="qc-card">

    <div class="h2 qc-title">{title}</div>
    <p class="qc-subtitle">📱 {subtitle}</p>

    {imageUrl && (
      <img
        src={imageUrl}
        alt="Layanan Monitoring Perangkat"
        class="qc-image"
      />
    )}

    <div class="qc-features">
      {features.map(feature => (
        <p>• {feature}</p>
      ))}
    </div>

    <slot />

    <p class="qc-note">
      🔒 Penggunaan sah & dengan persetujuan pemilik perangkat
    </p>

    <a
      href={`https://wa.me/${phone.replace(/\D/g, "")}`}
      class="qc-button"
    >
      Hubungi via WhatsApp
    </a>

  </div>
</div>

<style>
  .qc-wrapper {
    display: flex;
    justify-content: center;
    margin: 4rem 1rem;
  }

  .qc-card {
    max-width: 520px;
    width: 100%;
    background: var(--color-white);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    text-align: center;
    border-top: 6px solid var(--color-accent);
  }

  [data-theme="dark"] .qc-card {
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .qc-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .qc-subtitle {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  [data-theme="dark"] .qc-subtitle {
    color: var(--color-text-secondary);
  }

  .qc-image {
    width: 100%;
    max-height: 320px;
    object-fit: contain;
    /* Radius dalam = radius kartu (16px) - lebar border (1px) */
    border-radius: 15px;
    margin: 1.5rem 0;
  }

  .qc-features {
    text-align: left;
    margin: 1.5rem 0;
    color: var(--color-text-primary);
  }

  [data-theme="dark"] .qc-features {
    color: var(--color-text-primary);
  }

  .qc-features p {
    margin: 0.4rem 0;
    line-height: 1.6;
  }

  .qc-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0;
  }

  [data-theme="dark"] .qc-note {
    color: var(--color-text-muted);
  }

  .qc-button {
    display: inline-block;
    width: 100%;
    padding: 0.9rem 1.2rem;
    background: var(--color-accent);
    color: var(--color-white);
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .qc-button:hover {
    background: var(--color-accent-red-strong);
    transform: translateY(-2px);
  }
</style>
