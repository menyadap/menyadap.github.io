---
// src/components/Callout.astro
// Shortcode untuk callout/highlight box
// Gunakan: <Callout>Konten penting yang ingin disorot</Callout>
// Warna mengikuti palet Red/Black/White: default (hitam), primary (merah), secondary (merah tua)

interface Props {
  emoji?: string;
  type?: 'default' | 'primary' | 'secondary';
}

const {
  emoji = '💡',
  type = 'default'
} = Astro.props;
---

<!-- Callout box untuk highlight konten penting -->
<div class={`callout callout-${type}`}>
  <span class="callout-emoji">{emoji}</span>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    margin: 1.5rem 0;
    border-left: 4px solid var(--color-text-primary);
    border-radius: 6px;
    background-color: var(--color-surface);
  }

  .callout-default {
    border-left-color: var(--color-text-primary);
  }

  .callout-primary {
    border-left-color: var(--color-accent);
  }

  .callout-secondary {
    border-left-color: var(--color-accent-red-strong);
  }

  [data-theme="dark"] .callout-default {
    border-left-color: var(--color-gainsboro);
  }

  [data-theme="dark"] .callout-secondary {
    border-left-color: #ffb3b3;
  }

  .callout-emoji {
    font-size: 1.5rem;
    min-width: 2rem;
    display: flex;
    align-items: center;
  }

  .callout-content {
    flex: 1;
  }

  .callout-content :global(p) {
    margin: 0;
  }

  .callout-content :global(p + p) {
    margin-top: 0.5rem;
  }
</style>
