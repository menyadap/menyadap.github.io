---
// Alert.astro - Shortcode komponen untuk peringatan/notifikasi
// Gunakan di file .md dengan: <Alert type="warning">Konten peringatan</Alert>

interface Props {
  type?: 'info' | 'warning' | 'danger' | 'success';
  title?: string;
}

const {
  type = 'info',
  title
} = Astro.props;

// Warna dan ikon berdasarkan tipe alert
const alertConfig = {
  info: { icon: 'ℹ️', className: 'alert-info' },
  warning: { icon: '⚠️', className: 'alert-warning' },
  danger: { icon: '❌', className: 'alert-danger' },
  success: { icon: '✅', className: 'alert-success' }
};

const config = alertConfig[type];
---

<!-- Shortcode untuk alert/notification box -->
<div class={`alert ${config.className}`} role="alert">
  <div class="alert-content">
    <span class="alert-icon">{config.icon}</span>
    {title && <strong class="alert-title">{title}</strong>}
    <slot />
  </div>
</div>

<style>
  .alert {
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
  }

  .alert-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .alert-icon {
    font-size: 1.5rem;
    margin-right: 0.5rem;
    display: inline-block;
  }

  .alert-title {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  /*/ Warna mengikuti palet Red/Black/White: info & success netral,
      warning pakai tint merah, danger solid Spanish Red */
  .alert-info {
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .alert-success {
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border-color: var(--color-text-primary);
  }

  .alert-warning {
    color: #8a0b18;
    background-color: #fde7ea;
    border-color: #f3b9c1;
  }

  .alert-danger {
    color: #ffffff;
    background-color: var(--color-accent);
    border-color: var(--color-accent-red-strong);
  }

  [data-theme="dark"] .alert-info {
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  [data-theme="dark"] .alert-success {
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border-color: var(--color-gainsboro);
  }

  [data-theme="dark"] .alert-warning {
    color: #ffc2c9;
    background-color: #3a2226;
    border-color: #7d1220;
  }

  [data-theme="dark"] .alert-danger {
    color: #ffffff;
    background-color: var(--color-accent-red-strong);
    border-color: var(--color-accent);
  }
</style>

